# SOLO EJEMPLO FRONTEND: sustituir con configuración de un proyecto propio.
APP_ENV=academic
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_REPLACE_WITH_YOUR_OWN_PUBLIC_KEY
NORTHFLANK_PUBLIC_READ_ONLY=true
NORTHFLANK_PUBLIC_DATA_APPROVED=false
FRONTEND_PUBLIC_HOST=localhost
PORT=8501
SYMBOL=BTCUSDT
INTERVAL=1m
MODEL_CONFIDENCE_THRESHOLD=0.60
ACADEMIC_DEMO_ENABLED=false
ACADEMIC_DEMO_API_URL=https://your-academic-api.onrender.com
