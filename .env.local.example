# SOLO Docker Compose local. Valores ficticios; configure_local.py genera los reales.
COMPOSE_PROJECT_NAME=alpha-profesor
LOCAL_API_PORT=18000
LOCAL_STREAMLIT_PORT=18501
POSTGRES_PASSWORD=REPLACE_WITH_NEW_LOCAL_PASSWORD
INTERNAL_CRON_SECRET=REPLACE_WITH_NEW_LOCAL_CRON_SECRET
RECOMMENDATION_API_SECRET=REPLACE_WITH_NEW_LOCAL_API_SECRET
LOCAL_DEMO_MODE=true
PRESCRIPTIVE_NEWS_ENABLED=false
LLM_PROVIDER=nvidia
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_REASONING_EFFORT=low
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
ALPHA_VANTAGE_API_KEY=
BINANCE_BASE_URL=https://api.binance.com
